{
  "name": "trestle",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform multi-agent CLI orchestrator plugin for Claude Code",
  "scripts": {
    "test": "bun test src/__tests__",
    "test:unit": "bun test src/__tests__",
    "test:plugin": "claude plugin test .",
    "test:live": "bun run scripts/live_harness.ts",
    "validate": "claude plugin validate .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "saxes": "6.0.0",
    "zod": "4.6.7"
  }
}
