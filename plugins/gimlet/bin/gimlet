#!/usr/bin/env bash
# gimlet: runs C#/.NET security scanners (opengrep with the bundled rules, the SDK's Security
# analyzers, Dotnetarium, NuGet and OSV vulnerable-package checks, Betterleaks) over a repository,
# probes a running API (Spectral, Schemathesis, ZAP), and merges what they report.
set -euo pipefail

GIMLET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../config/defaults.env
source "$GIMLET_ROOT/config/defaults.env"
# shellcheck source=../lib/common.sh
source "$GIMLET_ROOT/lib/common.sh"
# shellcheck source=../lib/install.sh
source "$GIMLET_ROOT/lib/install.sh"
# shellcheck source=../lib/source.sh
source "$GIMLET_ROOT/lib/source.sh"
# shellcheck source=../lib/dotnet.sh
source "$GIMLET_ROOT/lib/dotnet.sh"
# shellcheck source=../lib/scan.sh
source "$GIMLET_ROOT/lib/scan.sh"
# shellcheck source=../lib/probe.sh
source "$GIMLET_ROOT/lib/probe.sh"
# shellcheck source=../lib/query.sh
source "$GIMLET_ROOT/lib/query.sh"

usage() {
  cat <<EOF
usage: gimlet <command> [options]

  scan [options] [PATH...]
                         scan PATHs (default: .) with every scanner and merge the findings
      --baseline REF     report only what changed since git REF (see the skill for per-scanner meaning)
      --only LIST        run only these scanners (comma-separated: ${ALL_SCANNERS[*]})
      --skip LIST        run every scanner except these
      --project FILE     .sln, .slnx or .csproj for the dotnet scanners (repeatable; default: discovered)
      --audit            also run opengrep's audit rules (entrypoint inventory; noisy by design)
      --sarif            also write opengrep SARIF next to the results
      --rules DIR        use DIR instead of the bundled opengrep rules (repeatable)
  probe --url URL [options]
                         test a running API through its OpenAPI document with ${ALL_PROBES[*]}
      --openapi URL|FILE the OpenAPI document (default: ${OPENAPI_CANDIDATES[*]} under URL)
      --auth-header 'Name: value'
                         header sent with every request
      --only LIST        run only these probes (comma-separated)
      --allow-remote     allow a target that is not on this machine
  query [REPORT|DIR] [options]
                         filter merged findings without reading the whole report
                         (default: the last scan of this repository)
      --severity LIST    filter by severity (comma-separated: error,warning,note)
      --tool LIST        filter by scanner tool name (comma-separated)
      --rule LIST        filter by rule id (comma-separated)
      --path SUBSTR      filter by file path substring
      --format FMT       output format: text (default), json, or sarif (SARIF 2.1.0)
  install [--version TAG]
                         install opengrep $GIMLET_OPENGREP_PINNED_TAG (checked against its pinned SHA-256),
                         or another release TAG (requires cosign to verify its signature)
  update                 install the latest opengrep release (requires cosign)
  version                print the pinned version of every tool and the opengrep release in use
  test                   run opengrep's rule tests over the bundled rules and fixtures
EOF
}

cmd_install() {
  local tag=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version) tag="${2:?--version needs a tag}"; shift 2 ;;
      *) die "install: unknown option $1" ;;
    esac
  done
  install_opengrep "$tag"
}

cmd_update() {
  local latest current
  latest="$(opengrep_latest_tag)"; current="$(opengrep_current_tag)"
  if [[ "$latest" == "$current" ]]; then
    echo "opengrep $current is the latest release"
  else
    echo "updating opengrep ${current:-<none>} -> $latest"
    install_opengrep "$latest"
  fi
}

cmd_version() {
  local tag; tag="$(opengrep_current_tag)"
  echo "opengrep     ${tag:-not installed} (pinned $GIMLET_OPENGREP_PINNED_TAG)"
  echo "dotnetarium  $GIMLET_DOTNETARIUM_VERSION"
  echo "betterleaks  $GIMLET_BETTERLEAKS_TAG"
  echo "osv-scanner  $GIMLET_OSV_TAG"
  echo "spectral     $GIMLET_SPECTRAL_VERSION (owasp ruleset $GIMLET_SPECTRAL_OWASP_VERSION)"
  echo "schemathesis $GIMLET_SCHEMATHESIS_VERSION"
  echo "zap          $GIMLET_ZAP_TAG"
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    scan) cmd_scan "$@" ;;
    probe) cmd_probe "$@" ;;
    query) cmd_query "$@" ;;
    install) cmd_install "$@" ;;
    update) cmd_update ;;
    version) cmd_version ;;
    test) test_opengrep ;;
    ""|-h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
