<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- ruleid: merk.security.webconfig-debug-compilation -->
    <compilation debug="true" targetFramework="4.8" />

    <!-- ruleid: merk.security.webconfig-custom-errors-off -->
    <customErrors mode="Off" />

    <!-- ruleid: merk.security.webconfig-request-validation-legacy -->
    <httpRuntime requestValidationMode="2.0" />

    <!-- ruleid: merk.security.webconfig-trace-enabled -->
    <trace enabled="true" pageOutput="true" />

    <!-- ruleid: merk.security.webconfig-cookies-not-ssl -->
    <httpCookies requireSSL="false" httpOnlyCookies="true" />
  </system.web>

  <!-- ok: merk.security.webconfig-debug-compilation -->
  <system.web>
    <compilation debug="false" targetFramework="4.8" />

    <!-- ok: merk.security.webconfig-custom-errors-off -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error" />

    <!-- ok: merk.security.webconfig-trace-enabled -->
    <trace enabled="false" />

    <!-- ok: merk.security.webconfig-cookies-not-ssl -->
    <httpCookies requireSSL="true" httpOnlyCookies="true" />
  </system.web>
</configuration>
