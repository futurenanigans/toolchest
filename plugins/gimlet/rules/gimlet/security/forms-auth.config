<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authentication mode="Forms">
      <!-- ruleid: gimlet.security.forms-auth-cookie-not-ssl -->
      <forms loginUrl="~/Login" requireSSL="false" timeout="2880" />
    </authentication>

    <authentication mode="Forms">
      <!-- ruleid: gimlet.security.forms-auth-cookieless-csharp -->
      <forms loginUrl="~/Login" cookieless="UseUri" timeout="60" />
    </authentication>

    <authentication mode="Forms">
      <!-- ruleid: gimlet.security.forms-auth-cookieless-csharp -->
      <forms loginUrl="~/Login" cookieless="AutoDetect" timeout="60" />
    </authentication>

    <authentication mode="Forms">
      <!-- ok: gimlet.security.forms-auth-cookie-not-ssl, gimlet.security.forms-auth-cookieless-csharp -->
      <forms loginUrl="~/Login" requireSSL="true" cookieless="UseCookies" timeout="60" />
    </authentication>
  </system.web>
</configuration>
