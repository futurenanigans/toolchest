<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- ruleid: gimlet.security.nuget-http-source -->
    <add key="internal" value="http://nuget.internal.example/v3/index.json" />
    <!-- ruleid: gimlet.security.nuget-http-source -->
    <add key="legacy" value="http://legacy.example/nuget" protocolVersion="2" />
    <!-- ruleid: gimlet.security.nuget-http-source -->
    <add value='http://mirror.example/feed' key='mirror' />
    <!-- ok: gimlet.security.nuget-http-source -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- ok: gimlet.security.nuget-http-source -->
    <add key="local" value="C:\packages" />
    <!-- ok: gimlet.security.nuget-http-source -->
    <add key="relative" value="./local-feed" />
  </packageSources>
</configuration>
