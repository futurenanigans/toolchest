# Defaults for bin/gimlet. Each can be overridden by an environment variable of the same name.
GIMLET_OPENGREP_REPO="${GIMLET_OPENGREP_REPO:-opengrep/opengrep}"
GIMLET_BETTERLEAKS_REPO="${GIMLET_BETTERLEAKS_REPO:-betterleaks/betterleaks}"
GIMLET_OSV_REPO="${GIMLET_OSV_REPO:-google/osv-scanner}"
GIMLET_ZAP_REPO="${GIMLET_ZAP_REPO:-zaproxy/zaproxy}"
GIMLET_GITHUB_DOWNLOAD="${GIMLET_GITHUB_DOWNLOAD:-https://github.com}"
GIMLET_NUGET_FLATCONTAINER="${GIMLET_NUGET_FLATCONTAINER:-https://api.nuget.org/v3-flatcontainer}"
GIMLET_COSIGN_IDENTITY_REGEXP="${GIMLET_COSIGN_IDENTITY_REGEXP:-^https://github.com/opengrep/opengrep/.+}"
GIMLET_COSIGN_OIDC_ISSUER="${GIMLET_COSIGN_OIDC_ISSUER:-https://token.actions.githubusercontent.com}"
GIMLET_HTTP_TIMEOUT_SECONDS="${GIMLET_HTTP_TIMEOUT_SECONDS:-300}"
GIMLET_SCHEMATHESIS_MAX_SECONDS="${GIMLET_SCHEMATHESIS_MAX_SECONDS:-120}"
GIMLET_ZAP_MAX_MINUTES="${GIMLET_ZAP_MAX_MINUTES:-10}"
GIMLET_FINDINGS_SHOWN_PER_TOOL="${GIMLET_FINDINGS_SHOWN_PER_TOOL:-40}"

