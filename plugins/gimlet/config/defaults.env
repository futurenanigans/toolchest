# Defaults for bin/gimlet. Each can be overridden by an environment variable of the same name.
GIMLET_OPENGREP_REPO="${GIMLET_OPENGREP_REPO:-opengrep/opengrep}"
GIMLET_GITHUB_DOWNLOAD="${GIMLET_GITHUB_DOWNLOAD:-https://github.com}"
GIMLET_COSIGN_IDENTITY_REGEXP="${GIMLET_COSIGN_IDENTITY_REGEXP:-^https://github.com/opengrep/opengrep/.+}"
GIMLET_COSIGN_OIDC_ISSUER="${GIMLET_COSIGN_OIDC_ISSUER:-https://token.actions.githubusercontent.com}"
GIMLET_HTTP_TIMEOUT_SECONDS="${GIMLET_HTTP_TIMEOUT_SECONDS:-300}"

# The opengrep release gimlet installs by default, and the SHA-256 of each release asset as GitHub
# reports it (`digest` on the release's assets). Keys are the asset names with dots as underscores.
GIMLET_OPENGREP_PINNED_TAG="v2.1.0"
GIMLET_SHA256_opengrep_linux_x86="d6a68a84c01a3d8ee933f60847decf1b4d0fd7791a26833b32b95922baf28974"
GIMLET_SHA256_opengrep_linux_aarch64="3abfc87d66f208efd143a1b408d489af934cea7d9968ab1f37dca001f9886092"
GIMLET_SHA256_opengrep_osx_arm64="0beb60121c3f1702c0aee34c0a7ca02599902f16676f54e4a95f317838f19bdd"
GIMLET_SHA256_opengrep_osx_x86="4009b6fa5c45e027835b54837eedf7aa5ea7d778c77a9f98f27cfbc463b2a0da"
GIMLET_SHA256_opengrep_windows_x86_zip="de250811f7209619e4fdafff55e5f13cb24a70c9cb0ea86435c2c92393ea04ab"
